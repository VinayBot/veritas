# Copy to .env and adjust. Everything has a free/local default — no paid key is required.
# Backend reads this file directly (backend/app/core/config.py). Frontend env vars (VITE_*)
# belong in frontend/.env — see frontend/.env.example.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Storage ---
DATA_DIR=./var/data
DATABASE_URL=sqlite+aiosqlite:///./var/data/veritas.db

# --- Hardware tier: "8gb" (3B models, council runs sequentially) or "16gb" (7B models, parallel council) ---
HARDWARE_TIER=16gb

# --- LLM routing (LiteLLM). Local Ollama by default; cloud keys below are optional. ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# The one model that writes answers. llama3.2:3b (2 GB) is the lightest and fastest.
DEFAULT_LLM_MODEL=ollama/llama3.2:3b
COUNCIL_MODELS=ollama/gemma2:2b,ollama/llama3.2:3b
# true = harder questions and agent grading steps use the first council model instead of
# the default one. Loads a second chat model; leave false on 16 GB or less.
ESCALATE_TO_STRONGER_MODEL=false
CHAIRMAN_MODEL=ollama/llama3.2:3b
# Model that scores answers. Leave blank to use DEFAULT_LLM_MODEL.
JUDGE_MODEL=
# Optional cloud LLMs (free tiers) — leave blank to stay fully local.
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Embeddings / reranker (baseline; the advisor may suggest an override per document) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Guard models ---
GUARD_MODEL=ollama/llama-guard3:1b
INJECTION_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2

# --- Vector / graph / cache stores ---
VECTOR_STORE=chroma
# Empty: Qdrant runs embedded, on disk under DATA_DIR/qdrant. Set to use a server instead.
QDRANT_URL=
GRAPH_STORE=networkx
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
REDIS_URL=
SEMANTIC_CACHE_ENABLED=true

# --- PII vault ---
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_VAULT_KEY=
# Secret for the deterministic HMAC-SHA256 PII tokenizer. Change in any non-dev environment.
PII_HMAC_SECRET=dev-only-change-me

# --- URL ingestion / SSRF guard ---
SCRAPE_TIMEOUT_SECONDS=10
SCRAPE_MAX_BYTES=5242880
SCRAPE_MAX_CRAWL_DEPTH=2
SCRAPE_MAX_PAGES=20

# --- Guardrails ---
RATE_LIMIT_PER_MINUTE=60
# Per client address on chat, upload, comparison, benchmark and red-team endpoints (0 = off).
CLIENT_RATE_LIMIT_PER_MINUTE=60
# Trust X-Forwarded-For for the client address; only behind a reverse proxy that sets it.
TRUST_FORWARDED_FOR=false
# API keys and roles (backend/app/core/auth.py). Off by default for a local single-user tool.
# API_KEYS is comma-separated key:role, roles viewer | analyst | admin; set the UI's key in
# frontend/.env as VITE_API_KEY.
AUTH_ENABLED=false
API_KEYS=

# --- Chat run reliability (Fix 1 — see docs/DECISIONS.md) ---
# Hard ceiling on one chat turn's wall-clock time before it's force-failed. Raised from this
# project's own suggested 150s starting point after a real timed run on 16GB-tier local
# hardware measured individual local-model calls at ~15-30s each — a full agentic/summarizer
# chain needs 6-10+ of them even on the happy path, so 150s cut off real, in-progress turns.
RUN_TIMEOUT_SECONDS=240
# Shorter budget for the one automatic retry-with-the-fast-model attempt after a timeout/budget
# failure — deliberately tighter than RUN_TIMEOUT_SECONDS since this attempt also skips
# council/the stronger model and (for the summary route) the map-reduce batching, not just a
# second try at the same cost.
RUN_RETRY_TIMEOUT_SECONDS=90
# Caps total LLM calls (generation + judging, not embedding/reranking) across one turn. The
# measured happy path is ~9 calls; this leaves headroom while still cutting off the unbounded
# worst case (critic retries x council fan-out) well before it could run for minutes.
MAX_LLM_CALLS_PER_RUN=14
# How long Ollama keeps a model's weights resident in memory after the preflight warm-up call.
OLLAMA_KEEP_ALIVE=10m
# Context window per request (tokens). Ollama's own default, 4096, silently cuts longer prompts.
OLLAMA_NUM_CTX=8192
# How the agent plans: "json" (default; routed 81% vs 62% for llama3.2:3b, see make planner-eval)
# or "tool_call" (the model's native tool calling, with the JSON prompt as fallback).
PLANNER_MODE=json
